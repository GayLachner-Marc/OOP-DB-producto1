<?xml version="1.0" encoding="UTF-8"?>

<persistence version="3.0"
             xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd">

    <persistence-unit name="OnlineStorePU">

        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <!-- ENTIDADES -->
        <class>com.compilers.onlinestore.model.Articulos.Articulo</class>
        <class>com.compilers.onlinestore.model.Pedidos.Pedido</class>
        <class>com.compilers.onlinestore.model.Clientes.Cliente</class>
        <class>com.compilers.onlinestore.model.Clientes.ClientePremium</class>
        <class>com.compilers.onlinestore.model.Clientes.ClienteEstandar</class>

        <properties>

            <!-- CONEXIÓN -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://localhost:3306/compilers"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>

            <!-- HIBERNATE -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- <property name="hibernate.show_sql" value="false"/>-->
            <property name="hibernate.format_sql" value="false"/>

        </properties>

    </persistence-unit>

</persistence>
