<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.compilers.onlinestore.view.controllers.ClientesController"
      spacing="20"
      styleClass="root"
      style="-fx-padding: 20;">

    <HBox spacing="20">

        <Label text="Gestión de Clientes"
                styleClass="title-label"/>

        <Button text="+ Añadir Cliente" onAction="#abrirFormularioCliente"
        styleClass="primary-button"/>
        
        <Button text="Editar Cliente"
        onAction="#editarCliente"
        styleClass="secondary-button"/>
        
        <Button text="Eliminar Cliente"
        onAction="#eliminarCliente"
        styleClass="danger-button"/>

    </HBox>

    <VBox styleClass="card">
    <TableView fx:id="tablaClientes"
               prefHeight="600">

        <columns>


            <TableColumn fx:id="colNombre"
                         text="Nombre"
                         prefWidth="120" />

            <TableColumn fx:id="colEmail"
                         text="Email"
                         prefWidth="350" />

            <TableColumn fx:id="colDomicilio"
                         text="Domicilio"
                         prefWidth="350" />

            <TableColumn fx:id="colNif"
                         text="NIF"
                         prefWidth="140" />

            <TableColumn fx:id="colTipoCliente"
                         text="Tipo de Cliente"
                         prefWidth="140" />

            <TableColumn fx:id="colCuotaAnual"
                         text="Cuota Anual"
                         prefWidth="140" />

        </columns>

    </TableView>

    </VBox>
</VBox>