<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.SVGPath?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.compilers.onlinestore.view.controllers.HomeController"
      spacing="30"
      alignment="TOP_CENTER"
      style="-fx-padding: 10 0 0 0; -fx-background-color: #f5f6f8;">

    <!-- CABECERA -->
    <VBox spacing="8"
          alignment="CENTER_LEFT"
          maxWidth="1248">

        <Label text="Bienvenido de nuevo"
               style="
                    -fx-font-size: 34px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #0f172a;
               "/>

        <Label text="Selecciona un módulo para comenzar"
               style="
                    -fx-font-size: 18px;
                    -fx-text-fill: #64748b;
               "/>

    </VBox>

    <!-- TARJETAS -->
    <HBox spacing="24"
          alignment="CENTER">

        <!-- CLIENTES -->
        <VBox fx:id="cardClientes"
              prefWidth="400"
              prefHeight="320"
              spacing="16"
              alignment="TOP_LEFT"
              style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-padding: 28;
                    -fx-cursor: hand;
                    -fx-effect: dropshadow(
                        three-pass-box,
                        rgba(0,0,0,0.08),
                        10,
                        0,
                        0,
                        3
                    );
              ">

           <StackPane prefWidth="56"
           prefHeight="56"
           minWidth="56"
           minHeight="56"
           maxWidth="56"
           maxHeight="56"
           alignment="CENTER"
           style="
                -fx-background-color: #eef2ff;
                -fx-background-radius: 16;
           ">

    <SVGPath content="
        M18 21
        A8 8 0 0 0 2 21

        M10 13
        A5 5 0 1 0 10 3
        A5 5 0 0 0 10 13

        M22 20
        C22 16.63 20 13.5 18 12

        M17.55 3.7
        A5 5 0 0 1 18 12"

             scaleX="1.35"
             scaleY="1.35"

             style="
                -fx-fill: transparent;
                -fx-stroke: #2563eb;
                -fx-stroke-width: 2;
             "/>

</StackPane>
            <Label text="Gestión de Clientes"
                   style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #0f172a;
                   "/>

            <Label text="Administra la información de tus clientes"
                   wrapText="true"
                   style="
                        -fx-font-size: 16px;
                        -fx-text-fill: #475569;
                   "/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Acceder →"
                   style="
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #4f46e5;
                   "/>

        </VBox>

        <!-- ARTÍCULOS -->
        <VBox fx:id="cardArticulos"
              prefWidth="400"
              prefHeight="320"
              spacing="16"
              alignment="TOP_LEFT"
              style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-padding: 28;
                    -fx-cursor: hand;
                    -fx-effect: dropshadow(
                        three-pass-box,
                        rgba(0,0,0,0.08),
                        10,
                        0,
                        0,
                        3
                    );
              ">

            <StackPane prefWidth="56"
                       prefHeight="56"
                       maxWidth="56"
                       maxHeight="56"
                       style="
                            -fx-background-color: #ecfdf5;
                            -fx-background-radius: 16;
                       ">

                <SVGPath content="
                    M11 21.73a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16V8
                    a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4
                    A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73z
                    M12 22V12
                    M3.29 7L12 12L20.71 7
                    M7.5 4.27L16.5 9.42"

                         scaleX="1.2"
                         scaleY="1.2"

                         style="
                            -fx-fill: transparent;
                            -fx-stroke: #16a34a;
                            -fx-stroke-width: 2;
                         "/>

            </StackPane>

            <Label text="Gestión de Artículos"
                   style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #0f172a;
                   "/>

            <Label text="Controla tu inventario y productos"
                   wrapText="true"
                   style="
                        -fx-font-size: 16px;
                        -fx-text-fill: #475569;
                   "/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Acceder →"
                   style="
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #4f46e5;
                   "/>

        </VBox>

        <!-- PEDIDOS -->
        <VBox fx:id="cardPedidos"
              prefWidth="400"
              prefHeight="320"
              spacing="16"
              alignment="TOP_LEFT"
              style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-padding: 28;
                    -fx-cursor: hand;
                    -fx-effect: dropshadow(
                        three-pass-box,
                        rgba(0,0,0,0.08),
                        10,
                        0,
                        0,
                        3
                    );
              ">

            <StackPane prefWidth="56"
           prefHeight="56"
           minWidth="56"
           minHeight="56"
           maxWidth="56"
           maxHeight="56"
           alignment="CENTER"
           style="
                -fx-background-color: #f3e8ff;
                -fx-background-radius: 16;
           ">

    <SVGPath content="
        M8 21A1 1 0 1 0 8 19
        A1 1 0 0 0 8 21

        M19 21A1 1 0 1 0 19 19
        A1 1 0 0 0 19 21

        M2.05 2.05H4.05
        L6.71 14.47
        A2 2 0 0 0 8.71 16.05
        H18.49
        A2 2 0 0 0 20.44 14.48
        L22.09 7.05
        H5.12"

             scaleX="1.35"
             scaleY="1.35"

             style="
                -fx-fill: transparent;
                -fx-stroke: #9333ea;
                -fx-stroke-width: 2;
             "/>

</StackPane>
            <Label text="Gestión de Pedidos"
                   style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #0f172a;
                   "/>

            <Label text="Administra los pedidos de tus clientes"
                   wrapText="true"
                   style="
                        -fx-font-size: 16px;
                        -fx-text-fill: #475569;
                   "/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Acceder →"
                   style="
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #4f46e5;
                   "/>

        </VBox>

    </HBox>

</VBox>