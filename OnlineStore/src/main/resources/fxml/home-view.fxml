<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.compilers.onlinestore.view.controllers.HomeController"
      spacing="30"
      alignment="TOP_CENTER"
      style="-fx-padding: 10 0 0 0; -fx-background-color: #f5f6f8;">

    <!-- CABECERA -->
    <VBox spacing="8"
          alignment="CENTER_LEFT">

        <Label text="Bienvenido de nuevo"
               style="
                    -fx-font-size: 34px;
                    -fx-font-weight: bold;
                    -fx-text-fill: #0f172a;
               "/>

        <Label text="Selecciona un módulo para comenzar"
               style="
                    -fx-font-size: 18px;
                    -fx-text-fill: #64748b;
               "/>

    </VBox>

    <!-- TARJETAS -->
    <HBox spacing="24"
          alignment="CENTER">

        <VBox fx:id="cardClientes"
              prefWidth="400"
              prefHeight="320"
              spacing="16"
              alignment="TOP_LEFT"
              style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-padding: 28;
                    -fx-cursor: hand;
              ">

            <Label text="👥"
                   style="-fx-font-size: 42px;" />

            <Label text="Gestión de Clientes"
                   style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                   "/>

            <Label text="Administra la información de tus clientes"
                   wrapText="true"
                   style="
                        -fx-font-size: 16px;
                        -fx-text-fill: #475569;
                   "/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Acceder →"
                   style="
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #4f46e5;
                   "/>

        </VBox>

        <VBox fx:id="cardArticulos"
              prefWidth="400"
              prefHeight="320"
              spacing="16"
              alignment="TOP_LEFT"
              style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-padding: 28;
                    -fx-cursor: hand;
              ">

            <Label text="📦"
                   style="-fx-font-size: 42px;" />

            <Label text="Gestión de Artículos"
                   style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                   "/>

            <Label text="Controla tu inventario y productos"
                   wrapText="true"
                   style="
                        -fx-font-size: 16px;
                        -fx-text-fill: #475569;
                   "/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Acceder →"
                   style="
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #4f46e5;
                   "/>

        </VBox>

        <VBox fx:id="cardPedidos"
              prefWidth="400"
              prefHeight="320"
              spacing="16"
              alignment="TOP_LEFT"
              style="
                    -fx-background-color: white;
                    -fx-background-radius: 18;
                    -fx-padding: 28;
                    -fx-cursor: hand;
              ">

            <Label text="🛒"
                   style="-fx-font-size: 42px;" />

            <Label text="Gestión de Pedidos"
                   style="
                        -fx-font-size: 24px;
                        -fx-font-weight: bold;
                   "/>

            <Label text="Administra los pedidos de tus clientes"
                   wrapText="true"
                   style="
                        -fx-font-size: 16px;
                        -fx-text-fill: #475569;
                   "/>

            <Region VBox.vgrow="ALWAYS"/>

            <Label text="Acceder →"
                   style="
                        -fx-font-size: 16px;
                        -fx-font-weight: bold;
                        -fx-text-fill: #4f46e5;
                   "/>

        </VBox>

    </HBox>

</VBox>
