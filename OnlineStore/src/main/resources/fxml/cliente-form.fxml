<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="14"
      alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.compilers.onlinestore.view.controllers.ClienteFormController"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="20"
                right="20"
                bottom="20"
                left="20"/>
    </padding>

    <Label text="Nuevo Cliente"
           style="-fx-font-size: 20px;
                  -fx-font-weight: bold;" />

    <TextField fx:id="txtNombre"
               promptText="Nombre"/>

    <TextField fx:id="txtEmail"
               promptText="Email"/>

    <TextField fx:id="txtDomicilio"
               promptText="Domicilio"/>

    <TextField fx:id="txtNif"
               promptText="NIF"/>

    <!-- Tipo cliente -->
    <ComboBox fx:id="comboTipoCliente"
              promptText="Tipo de Cliente"
              prefWidth="260"/>

    <!-- Solo premium -->
    <TextField fx:id="txtCuotaAnual"
               promptText="Cuota Anual"
               visible="false"
               managed="false"/>

    <Button text="Guardar"
            onAction="#guardarCliente"
            style="-fx-background-color: #2563eb;
                   -fx-text-fill: white;
                   -fx-font-weight: bold;" />

</VBox>