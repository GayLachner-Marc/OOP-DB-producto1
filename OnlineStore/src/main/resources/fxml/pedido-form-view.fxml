<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12"
      alignment="CENTER"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.compilers.onlinestore.view.controllers.PedidoFormController"
      style="-fx-background-color: white;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Nuevo Pedido"
           style="-fx-font-size: 22px;
                  -fx-font-weight: bold;" />

    <TextField fx:id="txtNumeroPedido"
               promptText="Número Pedido"
               prefWidth="320"/>

    <ComboBox fx:id="comboCliente"
              promptText="Seleccionar cliente"
              prefWidth="320"/>

    <ComboBox fx:id="comboArticulo"
              promptText="Seleccionar artículo"
              prefWidth="320"
              onAction="#actualizarPrecio"/>

    <TextField fx:id="txtCantidad"
               promptText="Cantidad"
               prefWidth="320"
               onKeyReleased="#actualizarTotal"/>

    <TextField fx:id="txtPrecioUnitario"
               promptText="Precio Unitario"
               editable="false"
               prefWidth="320"/>

    <TextField fx:id="txtTotal"
               promptText="Total"
               editable="false"
               prefWidth="320"/>

    <HBox spacing="12" alignment="CENTER">

        <Button text="Cancelar"
                onAction="#cancelar"
                style="-fx-background-color: #e5e7eb;
                       -fx-text-fill: #111827;
                       -fx-background-radius: 10;" />

        <Button text="Guardar"
                onAction="#guardarPedido"
                style="-fx-background-color: #2563eb;
                       -fx-text-fill: white;
                       -fx-background-radius: 10;" />

    </HBox>

</VBox>
