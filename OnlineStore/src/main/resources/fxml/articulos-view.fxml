<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="700.0"
            prefWidth="1200.0"
            style="-fx-background-color: #f5f6f8;"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.compilers.onlinestore.view.controllers.ArticulosController">

    <children>

        <VBox spacing="20"
              AnchorPane.topAnchor="20"
              AnchorPane.leftAnchor="20"
              AnchorPane.rightAnchor="20"
              AnchorPane.bottomAnchor="20">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT">

                <Label text="Gestión de Artículos"
                       style="
                            -fx-font-size: 34px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #0f172a;
                       "/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="+ Añadir Artículo"
                        onAction="#abrirFormularioArticulo"
                        style="
                            -fx-background-color: #2563eb;
                            -fx-text-fill: white;
                            -fx-font-size: 14px;
                            -fx-font-weight: bold;
                            -fx-background-radius: 12;
                            -fx-padding: 12 24;
                            -fx-cursor: hand;
                        "/>

            </HBox>

            <!-- FORMULARIO NUEVO ARTÍCULO -->
            <VBox fx:id="panelNuevoArticulo"
                  spacing="10"
                  visible="false"
                  managed="false"
                  prefHeight="280"
                  maxHeight="280"
                  style="
                        -fx-background-color: white;
                        -fx-background-radius: 14;
                        -fx-border-color: #e5e7eb;
                        -fx-border-radius: 14;
                        -fx-padding: 22;
                  ">

                <!-- TÍTULO -->
                <Label text="Nuevo Artículo"
                       style="
                            -fx-font-size: 18px;
                            -fx-font-weight: bold;
                            -fx-text-fill: #0f172a;
                       "/>

                <!-- FILA 1 -->
                <HBox spacing="12">

                    <VBox spacing="6"
                          HBox.hgrow="ALWAYS">

                        <Label text="Código*"
                               style="
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #0f172a;
                               "/>

                        <TextField fx:id="txtCodigo"
                                   promptText="Ej: ART001"
                                   style="
                                        -fx-background-radius: 10;
                                        -fx-border-radius: 10;
                                        -fx-border-color: #d1d5db;
                                        -fx-padding: 8;
                                   "/>

                    </VBox>

                    <VBox spacing="6"
                          HBox.hgrow="ALWAYS">

                        <Label text="Descripción*"
                               style="
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #0f172a;
                               "/>

                        <TextField fx:id="txtDescripcion"
                                   promptText="Descripción del artículo"
                                   style="
                                        -fx-background-radius: 10;
                                        -fx-border-radius: 10;
                                        -fx-border-color: #d1d5db;
                                        -fx-padding: 8;
                                   "/>

                    </VBox>

                </HBox>

                <!-- FILA 2 -->
                <HBox spacing="12">

                    <VBox spacing="6"
                          HBox.hgrow="ALWAYS">

                        <Label text="Precio Venta (€)*"
                               style="
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #0f172a;
                               "/>

                        <TextField fx:id="txtPrecio"
                                   promptText="0.00"
                                   style="
                                        -fx-background-radius: 10;
                                        -fx-border-radius: 10;
                                        -fx-border-color: #d1d5db;
                                        -fx-padding: 8;
                                   "/>

                    </VBox>

                    <VBox spacing="6"
                          HBox.hgrow="ALWAYS">

                        <Label text="Gastos Envío (€)*"
                               style="
                                    -fx-font-weight: bold;
                                    -fx-text-fill: #0f172a;
                               "/>

                        <TextField fx:id="txtEnvio"
                                   promptText="0.00"
                                   style="
                                        -fx-background-radius: 10;
                                        -fx-border-radius: 10;
                                        -fx-border-color: #d1d5db;
                                        -fx-padding: 8;
                                   "/>

                    </VBox>

                </HBox>

                <!-- FILA 3 -->
<HBox spacing="12">

    <VBox spacing="6"
          prefWidth="520">

        <Label text="Tiempo Preparación (minutos)*"
               style="
                    -fx-font-weight: bold;
                    -fx-text-fill: #0f172a;
               "/>

        <TextField fx:id="txtTiempo"
                   promptText="0"
                   style="
                        -fx-background-radius: 10;
                        -fx-border-radius: 10;
                        -fx-border-color: #d1d5db;
                        -fx-padding: 8;
                   "/>

    </VBox>

</HBox>

                <!-- BOTONES -->
                <HBox spacing="12"
                      alignment="CENTER_RIGHT">

                    <Region HBox.hgrow="ALWAYS"/>

                    <Button text="Cancelar"
                            onAction="#cancelarNuevoArticulo"
                            style="
                                -fx-background-color: white;
                                -fx-border-color: #d1d5db;
                                -fx-text-fill: #334155;
                                -fx-background-radius: 10;
                                -fx-border-radius: 10;
                                -fx-padding: 10 20;
                                -fx-cursor: hand;
                            "/>

                    <Button text="Guardar Artículo"
                            onAction="#guardarArticulo"
                            style="
                                -fx-background-color: #2563eb;
                                -fx-text-fill: white;
                                -fx-font-weight: bold;
                                -fx-background-radius: 10;
                                -fx-padding: 10 20;
                                -fx-cursor: hand;
                            "/>

                </HBox>

            </VBox>

            <!-- CARD TABLA -->
            <VBox fx:id="cardTablaArticulos"
                  spacing="0"
                  VBox.vgrow="ALWAYS"
                  style="
                        -fx-background-color: white;
                        -fx-background-radius: 14;
                        -fx-border-radius: 14;
                        -fx-border-color: #e5e7eb;
                  ">

                <!-- HEADER -->
                <HBox alignment="CENTER_LEFT"
                      style="
                            -fx-padding: 22;
                            -fx-border-color:
                                transparent
                                transparent
                                #e5e7eb
                                transparent;
                      ">

                    <Label text="Artículos"
                           style="
                                -fx-font-size: 24px;
                                -fx-font-weight: bold;
                                -fx-text-fill: #0f172a;
                           "/>

                </HBox>

                <!-- TABLA -->
                <TableView fx:id="tablaArticulos"
                           VBox.vgrow="ALWAYS"
                           style="
                                -fx-background-color: white;
                                -fx-border-color: transparent;
                           ">

                    <columns>

                        <TableColumn fx:id="colCodigo"
                                     text="CÓDIGO"/>

                        <TableColumn fx:id="colDescripcion"
                                     text="DESCRIPCIÓN"/>

                        <TableColumn fx:id="colPrecio"
                                     text="PRECIO"/>

                        <TableColumn fx:id="colEnvio"
                                     text="ENVÍO"/>

                        <TableColumn fx:id="colTiempo"
                                     text="TIEMPO"/>

                        <TableColumn fx:id="colAcciones"
                                     text="ACCIONES"/>

                    </columns>

                </TableView>

            </VBox>

        </VBox>

    </children>

</AnchorPane>